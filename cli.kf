record CliOptions(
    String target,
    String moduleQuery,
    Int verbose,
    Int help,
    Int valid
)

parseCliOptions(String[] args): CliOptions
{
    var target = ""
    var moduleQuery = ""
    var verbose = 0
    var help = 0
    var valid = 1

    if (args.length == 0)
    {
        valid = 0
    }
    else
    {
        if (args[0] == "--help" || args[0] == "-h")
        {
            help = 1
        }
        else if (args[0] == "--verbose" || args[0] == "-v")
        {
            valid = 0
        }
        else
        {
            target = args[0]
        }
    }

    if (args.length > 1)
    {
        if (args[1] == "--verbose" || args[1] == "-v")
        {
            verbose = 1
        }
        else
        {
            moduleQuery = args[1]
        }
    }

    if (args.length > 2)
    {
        if (args[2] == "--verbose" || args[2] == "-v")
        {
            verbose = 1
        }
        else
        {
            valid = 0
        }
    }

    if (args.length > 3)
    {
        valid = 0
    }

    return CliOptions(
        target,
        moduleQuery,
        verbose,
        help,
        valid
    )
}

printUsage()
{
    println("KoFLean - Linux Runtime Module Inspector")
    println("")
    println("usage:")
    println(
        "  make run PROCESS=<process-name|pid> " +
        "[MODULE=<module>] [VERBOSE=1]"
    )
    println("")
    println("examples:")
    println("  make run PROCESS=kcalc")
    println("  make run PROCESS=2454")
    println("  make run PROCESS=kcalc MODULE=test.so")
    println(
        "  make run PROCESS=kcalc " +
        "MODULE=test.so VERBOSE=1"
    )
}
