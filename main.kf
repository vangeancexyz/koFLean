main()
{
    var processName = "kcalc"

    println("[*] target: " + processName)

    var pid = findPid(processName)

    if (pid < 0)
    {
        println("[-] Process not found")
        return
    }

    println("[+] pid: " + pid)
    println("")

    var maps = readProcessMaps(pid)

    if (maps.length == 0)
    {
        println(
            "[-] cannot read /proc/" +
            pid +
            "/maps"
        )

        return
    }

    println(
        "[+] maps loaded: " +
        maps.length +
        " characters"
    )
    println("")

    scanMemoryMaps(maps, processName)

    println("[+] done")
}
