main(String[] args)
{
    var options = parseCliOptions(args)

    if (options.help == 1)
    {
        printUsage()
        return
    }

    if (options.valid == 0)
    {
        if (options.target.length == 0)
        {
            println("[-] missing process target")
        }
        else
        {
            println("[-] invalid arguments")
        }

        println("")
        printUsage()
        return
    }

    var target = resolveProcessTarget(options.target)

    if (target.valid == 0)
    {
        println("[-] process not found: " + options.target)
        return
    }

    var maps = readProcessMaps(target.pid)

    if (maps.length == 0)
    {
        println(
            "[-] cannot read /proc/" +
            target.pid +
            "/maps"
        )

        return
    }

    var summary = summarizeMemoryMaps(maps, target.name)
    var modules = buildModuleCatalog(maps, target.name)

    printInspectorHeader(
        target.name,
        target.pid,
        summary.regions,
        modules.size
    )

    if (options.moduleQuery.length > 0)
    {
        printModuleSearch(modules, options.moduleQuery)
    }
    else
    {
        printModuleCatalog(modules)
    }

    printNotableMappings(summary, modules)

    if (options.verbose == 1)
    {
        println("[MEMORY REGION DETAIL]")
        println("")
        scanMemoryMaps(maps, target.name)
    }

    println("[+] done")
}
