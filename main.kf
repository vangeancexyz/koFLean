main()
{
    var processName = "kcalc"

    println("[*] target: " + processName)

    var pid = findPid(processName)

    if (pid < 0)
    {
        println("[-] Process not found")
        return
    }

    println("[+] pid: " + pid)
    println("")

    var maps = readProcessMaps(pid)

    if (maps.length == 0)
    {
        println(
            "[-] Unable to read /proc/" +
            pid +
            "/maps"
        )

        return
    }

    println(
        "[+] maps loaded: " +
        maps.length +
        " characters"
    )

    var lineEnd = indexOfFrom(maps, "\n", 0)

    if (lineEnd < 0)
    {
        lineEnd = maps.length
    }

    var firstLine = maps.substring(0, lineEnd)

    var address = nextToken(firstLine, 0)
    var permissions = nextToken(firstLine, address.next)
    var offset = nextToken(firstLine, permissions.next)
    var device = nextToken(firstLine, offset.next)
    var inode = nextToken(firstLine, device.next)

    println("")
    println("[FIRST MAP TOKENS]")
    println("address     : " + address.text)
    println("permissions : " + permissions.text)
    println("offset      : " + offset.text)
    println("device      : " + device.text)
    println("inode       : " + inode.text)
}
