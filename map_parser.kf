isZeroHex(String text): Bool
{
    if (text.length == 0)
    {
        return false
    }

    var cursor = 0

    while (cursor < text.length)
    {
        if (text.substring(cursor, cursor + 1) != "0")
        {
            return false
        }

        cursor = cursor + 1
    }

    return true
}

classifyMap(String pathname): String
{
    if (pathname.length == 0)
    {
        return "anonymous"
    }

    if (pathname == "[stack]")
    {
        return "process_stack"
    }

    if (startsWithText(pathname, "[stack:"))
    {
        return "thread_stack"
    }

    if (pathname == "[vdso]")
    {
        return "vdso"
    }

    if (pathname == "[vvar]")
    {
        return "vvar"
    }

    if (pathname == "[vsyscall]")
    {
        return "vsyscall"
    }

    if (pathname == "[heap]")
    {
        return "heap"
    }

    if (startsWithText(pathname, "[anon:"))
    {
        return "anon_private"
    }

    if (startsWithText(pathname, "[anon_shmem:"))
    {
        return "anon_shared"
    }

    if (startsWithText(pathname, "["))
    {
        return "other"
    }

    return "file"
}

parseMapLine(String rawLine): MemoryRegion
{
    var line = trimText(rawLine)

    if (line.length == 0)
    {
        return invalidRegion()
    }

    var address = nextToken(line, 0)
    var permissions = nextToken(line, address.next)
    var offset = nextToken(line, permissions.next)
    var device = nextToken(line, offset.next)
    var inode = nextToken(line, device.next)

    if (
        address.text.length == 0 ||
        permissions.text.length == 0 ||
        offset.text.length == 0 ||
        device.text.length == 0 ||
        inode.text.length == 0
    )
    {
        return invalidRegion()
    }

    var dash = indexOfFrom(address.text, "-", 0)

    if (dash <= 0 || dash >= address.text.length - 1)
    {
        return invalidRegion()
    }

    var pathname = ""

    if (inode.next < line.length)
    {
        pathname = trimText(
            line.substring(inode.next, line.length)
        )
    }

    var fileDeleted = 0

    if (endsWithText(pathname, "(deleted)"))
    {
        fileDeleted = 1
    }

    return MemoryRegion(
        1,
        MapLocation(
            address.text.substring(0, dash),
            address.text.substring(
                dash + 1,
                address.text.length
            ),
            permissions.text
        ),
        MapBacking(
            offset.text,
            device.text,
            inode.text
        ),
        pathname,
        classifyMap(pathname),
        fileDeleted
    )
}
