import kof.io

record ProcessTarget(
    Int valid,
    Int pid,
    String name
)

findPid(String processName): Int
{
    var pid = 1

    while (pid <= 131072)
    {
        var candidateName = readProcessName(pid)

        if (candidateName == processName)
        {
            return pid
        }

        pid = pid + 1
    }

    return -1
}

readProcessName(Int pid): String
{
    try
    {
        return trimText(
            Path("/proc/" + pid + "/comm").readText()
        )
    }
    catch (String e)
    {
        return ""
    }
}

resolveProcessTarget(String target): ProcessTarget
{
    if (target.length == 0)
    {
        return ProcessTarget(0, -1, "")
    }

    if (isDecimalText(target))
    {
        var pid = parseDecimalInt(target)

        if (pid <= 0)
        {
            return ProcessTarget(0, -1, "")
        }

        var processName = readProcessName(pid)

        if (processName.length == 0)
        {
            return ProcessTarget(0, -1, "")
        }

        return ProcessTarget(1, pid, processName)
    }

    var pid = findPid(target)

    if (pid < 0)
    {
        return ProcessTarget(0, -1, "")
    }

    var processName = readProcessName(pid)

    if (processName.length == 0)
    {
        return ProcessTarget(0, -1, "")
    }

    return ProcessTarget(1, pid, processName)
}

readProcessMaps(Int pid): String
{
    try
    {
        return Path(
            "/proc/" + pid + "/maps"
        ).readText()
    }
    catch (String e)
    {
        return ""
    }
}
